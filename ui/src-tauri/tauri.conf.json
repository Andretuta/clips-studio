{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipador Tauri",
  "identifier": "local.clipador.tauri",
  "version": "0.1.0",
  "build": {
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "sessao-do-motor",
          "description": "A interface servida pelo Vite em localhost:5173 lê a chave de sessão do motor local.",
          "windows": ["clipador"],
          "remote": { "urls": ["http://localhost:5173/*"] },
          "permissions": ["allow-sessao-motor"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../build/icon.ico"]
  }
}
