{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipador Tauri",
  "identifier": "local.clipador.tauri",
  "version": "0.1.0",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "sessao-do-motor",
          "description": "A interface empacotada no binário lê a chave de sessão do motor local. Sem o campo remote, a permissão vale só para o código embutido — é o caminho do app instalado.",
          "windows": ["clipador"],
          "permissions": ["allow-sessao-motor"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../build/icon.ico"]
  }
}
